# Copy this file to .env and fill in real values. Never commit .env.
#
# NOTE: RAMP feedback requires an authenticated MSSIDC-role login (see
# RECON.md). This project never automates that login or its CAPTCHA — you
# log in yourself in a real browser window each run, and the script reuses
# that session. There is deliberately no username/password field here.

# --- Google Sheets destination ---
# Data is split across one worksheet per event month (e.g. "May 2026"),
# created automatically — there's no single fixed worksheet name to set.
GOOGLE_SHEET_ID=16LzFOcdDMjbf9vikoyuzPzGOx29vRq85WpOhKMFBti0
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json

# --- Politeness / rate limiting ---
REQUEST_DELAY_SECONDS=2
MAX_RETRIES=3

# How long (seconds) main.py waits for you to complete the manual login
# before giving up. daily_report.py defaults to 1800 (30 min) instead of
# this value if LOGIN_TIMEOUT_SECONDS is unset, since it's fired by a
# scheduler rather than someone already sitting at the terminal.
LOGIN_TIMEOUT_SECONDS=300

# --- Daily digest email (daily_report.py) ---
# The sending account here is a Zoho Mail account. SMTP_APP_PASSWORD is a
# Zoho application-specific password for it (requires 2FA to be enabled
# first) — generate one at https://accounts.zoho.in/home#security/apppassword
# (use the .com equivalent instead if the account isn't on Zoho's India
# cluster). Never the real account password, and never commit this file.
SMTP_USER=your-sending-account@example.com
SMTP_APP_PASSWORD=
# Defaults to Zoho's India SMTP cluster (smtp.zoho.in:465) — override here
# if the sending account is on a different Zoho region, or moves to a
# different provider entirely.
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
# Comma-separated list of report recipients.
REPORT_RECIPIENTS=recipient1@example.com,recipient2@example.com

# --- Login reminder (login_reminder.py) ---
# Who gets the 22:50 IST heads-up to do the manual RAMP login before the
# 23:00 job (com.mccia.ramp-login-reminder.plist). Falls back to
# REPORT_RECIPIENTS if unset.
LOGIN_REMINDER_RECIPIENTS=recipient@example.com

# --- Noon post-event admin check (admin_completion_check.py) ---
# Independent daily 12:00 IST check: for yesterday's (and any still-pending
# earlier) events, verifies the team has entered Registered/Attended MSME
# counts and uploaded the attendance-sheet + event-photo documents on the
# portal itself. Not about MSME feedback forms — that's still
# daily_report.py, now Monday-only. Falls back to REPORT_RECIPIENTS if unset.
ADMIN_CHECK_RECIPIENTS=recipient@example.com
# How long (seconds) admin_completion_check.py waits for the noon login.
# Same 1800s (30 min) default as daily_report.py since it's also fired by a
# scheduler rather than someone already at the terminal.
ADMIN_CHECK_LOGIN_TIMEOUT_SECONDS=1800

# Failure alerts (login never detected, portal down, crash) go only here;
# falls back to ADMIN_CHECK_RECIPIENTS if unset.
ADMIN_CHECK_ALERT_RECIPIENTS=recipient@example.com
